{
    "name": "flametrench/identity",
    "description": "Identity primitives for Flametrench: users, credentials (Argon2id-pinned passwords, passkeys, OIDC), and user-bound sessions with rotation on refresh.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": ["flametrench", "identity", "users", "credentials", "sessions", "argon2id", "passkey", "oidc"],
    "homepage": "https://flametrench.dev",
    "authors": [
        {
            "name": "NDC Digital, LLC",
            "homepage": "https://flametrench.dev"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-sodium": "*",
        "flametrench/ids": "dev-v03-pat-prefix as 0.3.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../ids-php",
            "options": { "symlink": false }
        }
    ],
    "suggest": {
        "ext-pdo": "Required by PostgresIdentityStore for the durable backend.",
        "ext-pdo_pgsql": "Postgres driver for PostgresIdentityStore."
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Flametrench\\Identity\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev"
}
